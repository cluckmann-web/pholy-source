# Dedicated PHOLY queue service; owner pholy, mode 0600 after replacing password.
bind 127.0.0.1
port 6388
protected-mode yes
requirepass REPLACE_WITH_RANDOM_REDIS_PASSWORD
daemonize no
supervised no
logfile ""
dir /var/www/vhosts/pholy.de/pholy-data/redis
dbfilename dump.rdb
appendonly yes
appenddirname appendonlydir
appendfsync everysec
save ""
maxmemory-policy noeviction
