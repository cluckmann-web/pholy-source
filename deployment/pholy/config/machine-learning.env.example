# Install as pholy-data/config/machine-learning.env, owner pholy, mode 0600.
IMMICH_HOST=127.0.0.1
IMMICH_PORT=3008
IMMICH_LOG_LEVEL=info
MACHINE_LEARNING_CACHE_FOLDER=/var/www/vhosts/pholy.de/pholy-data/cache/ml
MACHINE_LEARNING_MODEL_REVISION=v2
MACHINE_LEARNING_WORKERS=1
MACHINE_LEARNING_REQUEST_THREADS=4
MACHINE_LEARNING_MODEL_INTER_OP_THREADS=1
MACHINE_LEARNING_MODEL_INTRA_OP_THREADS=4
XDG_CACHE_HOME=/var/www/vhosts/pholy.de/pholy-data/cache/ml
HF_HOME=/var/www/vhosts/pholy.de/pholy-data/cache/huggingface
TMPDIR=/var/www/vhosts/pholy.de/pholy-data/tmp
NO_COLOR=1
TZ=Europe/Berlin
