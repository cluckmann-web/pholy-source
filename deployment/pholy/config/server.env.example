# Install as pholy-data/config/server.env, owner pholy, mode 0600.
# Plain systemd EnvironmentFile syntax; no shell substitutions.
NODE_ENV=production
IMMICH_ENV=production
IMMICH_HOST=127.0.0.1
IMMICH_PORT=2288
IMMICH_MEDIA_LOCATION=/mnt/familyphotos-storage/Cloud-Fotos/PHOLY
IMMICH_BUILD_DATA=/var/www/vhosts/pholy.de/pholy-runtime/current/build
IMMICH_CONFIG_FILE=/var/www/vhosts/pholy.de/pholy-data/config/immich.json
IMMICH_LOG_LEVEL=log
IMMICH_TRUSTED_PROXIES=127.0.0.1,::1
IMMICH_ALLOW_SETUP=true
IMMICH_ALLOW_EXTERNAL_PLUGINS=false
IMMICH_IGNORE_MOUNT_CHECK_ERRORS=false
DB_HOSTNAME=127.0.0.1
DB_PORT=5448
DB_DATABASE_NAME=pholy
DB_USERNAME=pholy_app
DB_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
DB_VECTOR_EXTENSION=vectorchord
REDIS_HOSTNAME=127.0.0.1
REDIS_PORT=6388
REDIS_DBINDEX=0
REDIS_PASSWORD=REPLACE_WITH_RANDOM_REDIS_PASSWORD
PHOLY_MEDIA_PREFIX=/var/www/vhosts/pholy.de/pholy-toolchain/media
XDG_CACHE_HOME=/var/www/vhosts/pholy.de/pholy-data/cache/server
TMPDIR=/var/www/vhosts/pholy.de/pholy-data/tmp
TZ=Europe/Berlin
NO_COLOR=1
