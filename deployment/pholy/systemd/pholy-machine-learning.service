[Unit]
Description=PHOLY machine learning (CPU)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=pholy
Group=psacln
UMask=0077
EnvironmentFile=/var/www/vhosts/pholy.de/pholy-data/config/machine-learning.env
WorkingDirectory=/var/www/vhosts/pholy.de/pholy-runtime/current/ml
ExecStart=/var/www/vhosts/pholy.de/pholy-runtime/current/bin/run-ml.sh
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/vhosts/pholy.de/pholy-data/cache /var/www/vhosts/pholy.de/pholy-data/tmp
RestrictSUIDSGID=true
CapabilityBoundingSet=
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
